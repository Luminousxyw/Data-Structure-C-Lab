{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build c",
      "type": "shell",
      "command": "gcc",
      "args": [
        "src\\*.c",
        "-g",
        "-Iinclude",
        "-o",
        "build\\main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}