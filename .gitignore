# ===================
# AI / 编辑器 配置 (含 API 密钥等极度敏感信息)
# ===================
.continue/
.cursor/
.copilot/
.aider.conf.yml
.aider.local.yml

# ===================
# 环境变量文件 (极大概率包含密钥和隐私配置)
# ===================
.env
.env.local
.env.*.local
*.env

# ===================
# 各类 IDE 的项目配置
# ===================
.vscode/
.idea/
*.swp
*.swo
*~
.settings/
*.sublime-project
*.sublime-workspace

# ===================
# 系统 / 操作系统垃圾文件
# ===================
.DS_Store          # macOS
Thumbs.db          # Windows
desktop.ini

# ===================
# C / C++ 编译产物和中间文件
# ===================
# 可执行文件（Linux/Mac）
*.out
*.o
*.so
*.a
*.exe
*.dll
*.dylib

# 调试和中间文件
*.ilk
*.pdb
*.idb
*.exp
*.lib

# GDB 文件
.gdbinit

# 编译缓存
*.obj
*.suo
*.user
*.ncb

# ===================
# 包管理器 / 第三方库 (如果需要保留应在自己控制下提交)
# ===================
node_modules/
vendor/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ===================
# Docker / 容器 (可能包含构建密钥)
# ===================
.dockerignore
docker-compose.override.yml

# ===================
# 日志和临时文件
# ===================
*.log
*.tmp
*.bak
*.cache